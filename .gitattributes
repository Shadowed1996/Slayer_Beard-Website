# Normalizzazione delle fini riga: nel repository si conserva sempre LF.
# Il progetto nasce su Windows ma i file sono già tutti a LF, e devono
# restarci anche quando core.autocrlf è acceso sulla macchina di chi lavora.
* text=auto eol=lf

# I file batch di Windows fanno eccezione: vogliono CRLF nella copia locale.
*.cmd text eol=crlf
*.bat text eol=crlf

# File di controllo: testo, sempre.
.gitattributes text
.gitignore     text
.editorconfig  text

# Testo esplicito, per non lasciarlo indovinare.
*.md   text
*.html text
*.css  text
*.js   text
*.json text
*.svg  text
*.yml  text
*.yaml text
*.tpl  text
*.sh   text eol=lf

# --- Binari: niente diff, niente normalizzazione delle fini riga ----------
*.png  binary
*.PNG  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.avif binary
*.ico  binary
*.mp4  binary
*.webm binary
*.mp3  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.exe  binary
*.dll  binary

# --- Statistiche di GitHub (linguist) -------------------------------------
# La documentazione lunga non deve contare come "linguaggio del progetto".
docs/**            linguist-documentation
CONTRATTO.md       linguist-documentation
CONTRATTO-2.md     linguist-documentation
CONTRATTO-3.md     linguist-documentation
RIPRENDI-DOMANI.md linguist-documentation

# I file generati non sono lavoro scritto a mano: si escludono dalle
# statistiche e si comprimono nei diff, dove sono solo rumore.
index.html   linguist-generated
js/dati.js   linguist-generated
css/tema.css linguist-generated

# Le copie di sicurezza scritte dal pannello: né statistiche né diff.
server/backup/** linguist-generated
