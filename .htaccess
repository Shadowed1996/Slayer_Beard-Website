<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} !^$
  RewriteCond %{HTTP_HOST} !^www\.slayerbeard\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTP_HOST} ^www\.slayerbeard\.com$ [NC]
  RewriteRule ^ https://slayerbeard.com%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^\.well-known/ - [L]

  RewriteRule ^contenuti/media/ - [L]

  RewriteRule ^mp3/[^/]+\.(mp3|m4a|ogg|opus|webm)$ - [L]

  RewriteRule ^contenuti/font/[^/]+\.(woff2|woff|ttf|otf)$ - [L]

  RewriteRule ^server(/|$) - [F,L]

  RewriteRule ^modelli(/|$) - [F,L]

  RewriteRule ^docs(/|$) - [F,L]

  RewriteRule ^contenuti(/|$) - [F,L]

  RewriteRule ^app\.js$ - [F,L]
  RewriteRule ^package(-lock)?\.json$ - [F,L]

  RewriteRule \.md$ - [F,L]

  RewriteRule (^|/)\.[^/]+ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^\.|^app\.js$|^package(-lock)?\.json$|^auth\.json$|^chiavi\.js$|^twitch-accesso\.json$|\.md$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <IfModule mod_access_compat.c>
    <FilesMatch "^\.|^app\.js$|^package(-lock)?\.json$|^auth\.json$|^chiavi\.js$|^twitch-accesso\.json$|\.md$">
      Order allow,deny
      Deny from all
    </FilesMatch>
  </IfModule>
</IfModule>

<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/plain
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|htm|css|js|mjs)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  <FilesMatch "^stato-sito\.json$">
    Header set Cache-Control "no-store"
  </FilesMatch>

  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2|woff|ttf|otf|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

<IfModule !mod_headers.c>
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/avif "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
  </IfModule>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"

  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  Header always set X-Frame-Options "SAMEORIGIN"

  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
</IfModule>

<IfModule mod_setenvif.c>
  SetEnvIf X-Forwarded-Proto "^https$" SB_HTTPS=1
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" env=SB_HTTPS
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType audio/wav .wav
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_dir.c>
  DirectoryIndex index.html index.htm
</IfModule>

<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
